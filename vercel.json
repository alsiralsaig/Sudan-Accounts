{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/parse-sale.ts": {
      "maxDuration": 30
    },
    "api/cloud/*.ts": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/staff",
      "destination": "/"
    },
    {
      "source": "/staff/(.*)",
      "destination": "/"
    }
  ]
}