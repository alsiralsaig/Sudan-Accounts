# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ═══════════ السحابة (اختياري — بدونها التطبيق يعمل محلي بالكامل) ═══════════
# DATABASE_URL: رابط Postgres من Neon أو Supabase — مزامنة البيانات بين الأجهزة.
#   Neon:     Dashboard → Project → Connection string (pooled, المنتهي بـ -pooler)
#   Supabase: Project Settings → Database → Connection string → URI (استخدم Pooler منفذ 6544)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# AUTH_SECRET (اختياري): مفتاح توقيع جلسات السحابة.
# لو ما اتحدد بيتشتق تلقائياً من DATABASE_URL — حطو بس لو عايز تعطل كل الجلسات بتغييرو.
AUTH_SECRET=""
